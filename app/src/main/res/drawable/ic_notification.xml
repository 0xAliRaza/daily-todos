<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon: the app's focus dial, drawn bolder so it holds up at status-bar size. Notification
  icons are white on transparent; the faint track keeps its alpha.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The dial's track: the whole round, faint. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.45"
        android:strokeWidth="2"
        android:pathData="M4.4,12 A7.6,7.6 0 1,1 19.6,12 A7.6,7.6 0 1,1 4.4,12" />
    <!-- Focus done so far: two thirds of the round, from twelve o'clock. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M12.00,4.40 A7.6,7.6 0 1,1 5.42,15.80" />
    <!-- The hand, from the hub to where focus has reached. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:pathData="M12,12L5.42,15.80" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9.7,12 a2.3,2.3 0 1,0 4.6,0 a2.3,2.3 0 1,0 -4.6,0" />
</vector>
